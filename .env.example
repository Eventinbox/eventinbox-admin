# Base URL of the EventInbox API. Inlined into the client bundle at build time,
# so it must be set during `pnpm build` (and the Docker build arg), not just at
# runtime.
NEXT_PUBLIC_API_URL=https://api.eventinbox.pro

# Optional server-side IP allow-list for the /admin surface, enforced in
# middleware.ts before any page renders. Comma-separated; supports exact
# IPv4/IPv6 and "10.0." style prefixes. Leave empty/unset to allow all networks.
# Visit /api/whoami to see the IP the server sees for your connection.
# ADMIN_IP_WHITELIST=203.0.113.7,10.0.
